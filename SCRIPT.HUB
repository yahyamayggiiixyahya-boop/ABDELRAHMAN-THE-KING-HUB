--[=[
    ABDELRAHMAN THE KING HUB - ULTIMATE SECURE v7.0
    Features: Advanced Anti-Kick, Delta Auto-File Save, 24/7 Online Status & Strict Schedule Lock.
--]=]

local _ENV = (getgenv or function() return _ENV end)()
local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer

-- التحقق من الأوقات المحظورة (تقفيل السكربت أوتوماتيك في الأوقات المحددة)
local function checkScheduleTime()
    local dateTable = os.date("*t")
    local hour = dateTable.hour
    -- الأوقات المطلوبة للإغلاق: من 7 لـ 8، ومن 12 لـ 1، ومن 7 لـ 9 (مساءً أو صباحاً حسب التوقيت المحلي)
    if (hour >= 7 and hour < 8) or (hour >= 12 and hour < 1) or (hour >= 19 and hour < 21) or (hour >= 7 and hour < 9 and dateTable.isdst) then
        return false -- مغلق في هذه الأوقات
    end
    return true -- مسموح بالعمل
end

-- واجهة نظام المفتاح
local KeyGui = Instance.new("ScreenGui")
KeyGui.Name = "SecureKeySystem"
KeyGui.ResetOnSpawn = false
pcall(function() KeyGui.Parent = CoreGui end)
if not KeyGui.Parent then KeyGui.Parent = LocalPlayer:WaitForChild("PlayerGui") end

