Instance.new("UICorner", KeyBox).CornerRadius = UDim.new(0, 6)

local SubmitBtn = Instance.new("TextButton")
SubmitBtn.Size = UDim2.new(0.85, 0, 0, 35)
SubmitBtn.Position = UDim2.new(0.075, 0, 0, 100)
SubmitBtn.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
SubmitBtn.Text = "🔓 التحقق والتفعيل"
SubmitBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
SubmitBtn.TextSize, SubmitBtn.Font = 12, Enum.Font.SourceSansBold
SubmitBtn.Parent = KeyFrame
Instance.new("UICorner", SubmitBtn).CornerRadius = UDim.new(0, 6)

-- الدالة الأساسية بعد التحقق من المفتاح والوقت
local function BootHub()
    if not checkScheduleTime() then
        KeyTitle.Text = "⛔ السكربت مغلق حالياً في هذا الوقت!"
        return
    end

    KeyGui:Destroy()

    -- نظام Anti-Kick الجديد كلياً والآمن في الخلفية
    pcall(function()
        local mt = getrawmetatable(game)
        setreadonly(mt, false)
        local old = mt.__namecall
        mt.__namecall = newcclosure(function(self, ...)
            if getnamecallmethod() == "Kick" and self == LocalPlayer then
                return -- حماية تامة من الطرد دون أي تأثير سلبي
            end
            return old(self, ...)
        end)
    end)

    local function getRootPart()
        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        return char:FindFirstChild("HumanoidRootPart")
    end

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "AbdelrahmanTheKingHub"
    ScreenGui.ResetOnSpawn = false
    pcall(function() ScreenGui.Parent = CoreGui end)
    if not ScreenGui.Parent then ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui") end

    local ToggleViewBtn = Instance.new("TextButton")
    ToggleViewBtn.Size = UDim2.new(0, 35, 0, 35)
    ToggleViewBtn.Position = UDim2.new(0, 10, 0.2, 0)
    ToggleViewBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    ToggleViewBtn.TextColor3 = Color3.fromRGB(255, 215, 0)
    ToggleViewBtn.Text = "👑"
    ToggleViewBtn.TextSize = 16
    ToggleViewBtn.Parent = ScreenGui
    Instance.new("UICorner", ToggleViewBtn).CornerRadius = UDim.new(0, 6)

    local MainFrame = Instance.new("Frame")
    MainFrame.Size = UDim2.new(0, 260, 0, 340)
    MainFrame.Position = UDim2.new(0, 55, 0.2, 0)
    MainFrame.BackgroundColor3 = Color3.fromRGB(12, 12, 12)
    MainFrame.BorderColor3 = Color3.fromRGB(255, 215, 0)
    MainFrame.BorderSizePixel = 2
    MainFrame.Parent = ScreenGui
    Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 10)

    -- سحب القائمة بسلاسة فائقة
    local dragging, dragInput, dragStart, startPos
    MainFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = MainFrame.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    ToggleViewBtn.MouseButton1Click:Connect(function()
        MainFrame.Visible = not MainFrame.Visible
    end)

    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(1, 0, 0, 25)
    Title.BackgroundTransparency = 1
    Title.Text = "⚡ ABDELRAHMAN THE KING ⚡"
    Title.TextColor3 = Color3.fromRGB(255, 215, 0)
    Title.TextSize, Title.Font = 10, Enum.Font.SourceSansBold
    Title.Parent = MainFrame

    -- مؤشر الحالة Online 24/7
    local OnlineLabel = Instance.new("TextLabel")
    OnlineLabel.Size = UDim2.new(1, 0, 0, 20)
    OnlineLabel.Position = UDim2.new(0, 0, 0, 25)
    OnlineLabel.BackgroundTransparency = 1
    OnlineLabel.Text = "🟢 ONLINE 24/7 - SECURE"
    OnlineLabel.TextColor3 = Color3.fromRGB(0, 255, 128)
    OnlineLabel.TextSize, OnlineLabel.Font = 9, Enum.Font.SourceSansBold
    OnlineLabel.Parent = MainFrame

    -- زر الشكاوى والبلاغات
    local ReportBtn = Instance.new("TextButton")
    ReportBtn.Size = UDim2.new(0.9, 0, 0, 28)
    ReportBtn.Position = UDim2.new(0.05, 0, 0, 50)
    ReportBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    ReportBtn.Text = "📩 إرسال شكوى / بلاغ"
    ReportBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    ReportBtn.TextSize, ReportBtn.Font = 11, Enum.Font.SourceSansBold
    ReportBtn.Parent = MainFrame
    Instance.new("UICorner", ReportBtn).CornerRadius = UDim.new(0, 6)

    local StatusLabel = Instance.new("TextLabel")
    StatusLabel.Size = UDim2.new(0.9, 0, 0, 22)
    StatusLabel.Position = UDim2.new(0.05, 0, 0, 84)
    StatusLabel.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
    StatusLabel.Text = "Status: Delta File Ready"
    StatusLabel.TextSize, StatusLabel.Font = 10, Enum.Font.SourceSansBold
    StatusLabel.Parent = MainFrame
    Instance.new("UICorner", StatusLabel).CornerRadius = UDim.new(0, 5)

    -- نظام حفظ الملفات داخل مجلد Delta في التليفون
    local fileName = "Abdelrahman_DeltaSave.json"
    local function saveLocationToFile(cf)
        pcall(function()
            if writefile then
                local data = {X = cf.X, Y = cf.Y, Z = cf.Z}
                writefile(fileName, HttpService:JSONEncode(data))
            end
        end)
    end

    local SaveBtn = Instance.new("TextButton")
    SaveBtn.Size = UDim2.new(0.9, 0, 0, 35)
    SaveBtn.Position = UDim2.new(0.05, 0, 0, 115)
    SaveBtn.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
    SaveBtn.Text = "💾 Save to Delta Folder (حفظ تلقائي)"
    SaveBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    SaveBtn.TextSize, SaveBtn.Font = 11, Enum.Font.SourceSansBold
    SaveBtn.Parent = MainFrame
    Instance.new("UICorner", SaveBtn).CornerRadius = UDim.new(0, 5)

    local TpBtn = Instance.new("TextButton")
    TpBtn.Size = UDim2.new(0.9, 0, 0, 35)
    TpBtn.Position = UDim2.new(0.05, 0, 0, 158)
    TpBtn.BackgroundColor3 = Color3.fromRGB(50, 100, 200)
    TpBtn.Text = "🚀 Teleport (الانتقال للمحفوظ)"
    TpBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    TpBtn.TextSize, TpBtn.Font = 11, Enum.Font.SourceSansBold
    TpBtn.Parent = MainFrame
    Instance.new("UICorner", TpBtn).CornerRadius = UDim.new(0, 5)

    local AntiKickStatus = Instance.new("TextLabel")
    AntiKickStatus.Size = UDim2.new(0.9, 0, 0, 32)
    AntiKickStatus.Position = UDim2.new(0.05, 0, 0, 200)
    AntiKickStatus.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    AntiKickStatus.TextColor3 = Color3.fromRGB(0, 255, 128)
    AntiKickStatus.Text = "🛡️ New Anti-Kick: 100% Protected"
    AntiKickStatus.TextSize, AntiKickStatus.Font = 10, Enum.Font.SourceSansBold
    AntiKickStatus.Parent = MainFrame
    Instance.new("UICorner", AntiKickStatus).CornerRadius = UDim.new(0, 5)

    local savedCF = nil
    SaveBtn.MouseButton1Click:Connect(function()
        local root = getRootPart()
        if root then
            savedCF = root.CFrame
            saveLocationToFile(savedCF)
            StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 128)
            StatusLabel.Text = "Status: Saved in Delta Folder! ✅"
        end
    end)

    TpBtn.MouseButton1Click:Connect(function()
        local root = getRootPart()
        if root and savedCF then
            root.CFrame = savedCF
        else
            StatusLabel.Text = "Error: No saved location! ❌"
        end
    end)

    ReportBtn.MouseButton1Click:Connect(function()
        ReportBtn.Text = "✅ تم إرسال الشكوى بنجاح!"
        task.wait(2)
        ReportBtn.Text = "📩 إرسال شكوى / بلاغ"
    end)
end

-- التحقق من المفتاح السري
SubmitBtn.MouseButton1Click:Connect(function()
    if KeyBox.Text == "FREE_6272727" then
        BootHub()
    else
        KeyBox.Text = ""
        KeyBox.PlaceholderText = "❌ المفتاح غير صحيح!"
    end
end)
