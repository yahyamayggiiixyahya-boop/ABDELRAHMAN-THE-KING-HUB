local _ENV = (getgenv or function() return _ENV end)()
local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer

-- دالة فحص أوقات الصيانة الدقيقة
local function checkMaintenanceTime()
    local dateTable = os.date("*t")
    local hour = dateTable.hour
    local min = dateTable.min
    local totalMins = hour * 60 + min

    -- مواعيد الصيانة التي يتم فيها الطرد وإغلاق السكربت (8:30، 9:00، 9:30، 10:30)
    local maintTimes = {
        {8, 30},
        {9, 0},
        {9, 30},
        {10, 30}
    }

    for _, t in ipairs(maintTimes) do
        local targetMins = t[1] * 60 + t[2]
        -- لو الوقت الحالي ضمن نطاق 5 دقائق من موعد الصيانة المحدد
        if math.abs(totalMins - targetMins) <= 5 then
            return false, "السكربت دلوقتي في صيانة ومش هيشتغل غير بعد ساعة"
        end
    end

    return true, ""
end

-- واجهة نظام الإدخال (خانة واحدة)
