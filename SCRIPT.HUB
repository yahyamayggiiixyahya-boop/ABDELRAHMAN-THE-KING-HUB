-- دالة تشغيل السكربت الرئيسي
local function BootHub(isVipMode)
    local isAllowed, maintMsg = checkMaintenanceTime()
    if not isAllowed then
        pcall(function()
            LocalPlayer:Kick(maintMsg)
        end)
        return
    end

    KeyGui:Destroy()

    -- حماية Anti-Kick الأساسية
    pcall(function()
        local mt = getrawmetatable(game)
        setreadonly(mt, false)
        local old = mt.__namecall
        mt.__namecall = newcclosure(function(self, ...)
            if getnamecallmethod() == "Kick" and self == LocalPlayer then return end
            return old(self, ...)
        end)
    end)

    local function getRootPart()
        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        return char:FindFirstChild("HumanoidRootPart")
    end

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "AbdelrahmanTheKingHub"
    ScreenGui.ResetOnSpawn = false
    pcall(function() ScreenGui.Parent = CoreGui end)
    if not ScreenGui.Parent then ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui") end

    local ToggleViewBtn = Instance.new("TextButton")
    ToggleViewBtn.Size = UDim2.new(0, 35, 0, 35)
    ToggleViewBtn.Position = UDim2.new(0, 10, 0.2, 0)
    ToggleViewBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    ToggleViewBtn.TextColor3 = Color3.fromRGB(255, 215, 0)
    ToggleViewBtn.Text = "👑"
    ToggleViewBtn.TextSize = 16
    ToggleViewBtn.Parent = ScreenGui
    Instance.new("UICorner", ToggleViewBtn).CornerRadius = UDim.new(0, 6)

    local MainFrame = Instance.new("Frame")
    MainFrame.Size = UDim2.new(0, 260, 0, 390)
    MainFrame.Position = UDim2.new(0, 55, 0.2, 0)
    MainFrame.BackgroundColor3 = Color3.fromRGB(12, 12, 12)
    MainFrame.BorderColor3 = Color3.fromRGB(255, 215, 0)
    MainFrame.BorderSizePixel = 2
    MainFrame.Parent = ScreenGui
    Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 10)

    -- سحب القائمة بسلاسة
    local dragging, dragStart, startPos
    MainFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = MainFrame.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    ToggleViewBtn.MouseButton1Click:Connect(function()
        MainFrame.Visible = not MainFrame.Visible
    end)

    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(1, 0, 0, 25)
    Title.BackgroundTransparency = 1
    Title.Text = "⚡ ABDELRAHMAN THE KING ⚡"
    Title.TextColor3 = Color3.fromRGB(255, 215, 0)
    Title.TextSize, Title.Font = 10, Enum.Font.SourceSansBold
    Title.Parent = MainFrame

    local TimerLabel = Instance.new("TextLabel")
    TimerLabel.Size = UDim2.new(1, 0, 0, 22)
    TimerLabel.Position = UDim2.new(0, 0, 0, 25)
    TimerLabel.BackgroundTransparency = 1
    TimerLabel.TextSize, TimerLabel.Font = 10, Enum.Font.SourceSansBold
    TimerLabel.Parent = MainFrame

    if isVipMode then
        TimerLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        task.spawn(function()
            local timeLeft = 600 -- 10 دقائق للـ VIP
            while timeLeft > 0 do
                local mins = math.floor(timeLeft / 60)
                local secs = timeLeft % 60
                TimerLabel.Text = string.format("⏳ VIP Time Left: %02d:%02d", mins, secs)
                task.wait(1)
                timeLeft = timeLeft - 1
            end
            pcall(function()
                LocalPlayer:Kick("السكربت دلوقتي في صيانة ومش هيشتغل غير بعد ساعة")
            end)
        end)
    else
        TimerLabel.TextColor3 = Color3.fromRGB(0, 255, 128)
        TimerLabel.Text = "🟢 ONLINE - NORMAL MODE"
    end

    -- فحص دوري في الخلفية لو دخل وقت الصيانة والسكربت شغال
    task.spawn(function()
        while true do
            task.wait(30)
            local ok, msg = checkMaintenanceTime()
            if not ok then
                pcall(function()
                    LocalPlayer:Kick(msg)
                end)
                break
            end
        end
    end)

    local ReportBtn = Instance.new("TextButton")
    ReportBtn.Size = UDim2.new(0.9, 0, 0, 28)
    ReportBtn.Position = UDim2.new(0.05, 0, 0, 52)
    ReportBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    ReportBtn.Text = "📩 إرسال شكوى / بلاغ"
    ReportBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    ReportBtn.TextSize, ReportBtn.Font = 11, Enum.Font.SourceSansBold
    ReportBtn.Parent = MainFrame
    Instance.new("UICorner", ReportBtn).CornerRadius = UDim.new(0, 6)

    local StatusLabel = Instance.new("TextLabel")
    StatusLabel.Size = UDim2.new(0.9, 0, 0, 22)
    StatusLabel.Position = UDim2.new(0.05, 0, 0, 85)
    StatusLabel.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
    StatusLabel.Text = "Status: Delta File Ready"
    StatusLabel.TextSize, StatusLabel.Font = 10, Enum.Font.SourceSansBold
    StatusLabel.Parent = MainFrame
    Instance.new("UICorner", StatusLabel).CornerRadius = UDim.new(0, 5)

    local fileName = "Abdelrahman_DeltaSave.json"
    local function saveLocationToFile(cf)
        pcall(function()
            if writefile then
                local data = {X = cf.X, Y = cf.Y, Z = cf.Z}
                writefile(fileName, HttpService:JSONEncode(data))
            end
        end)
    end

    local SaveBtn = Instance.new("TextButton")
    SaveBtn.Size = UDim2.new(0.9, 0, 0, 32)
    SaveBtn.Position = UDim2.new(0.05, 0, 0, 115)
    SaveBtn.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
    SaveBtn.Text = "💾 Save Location"
    SaveBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    SaveBtn.TextSize, SaveBtn.Font = 11, Enum.Font.SourceSansBold
    SaveBtn.Parent = MainFrame
    Instance.new("UICorner", SaveBtn).CornerRadius = UDim.new(0, 5)

    local autoSaveActive = false
    local AutoSaveBtn = Instance.new("TextButton")
    AutoSaveBtn.Size = UDim2.new(0.9, 0, 0, 32)
    AutoSaveBtn.Position = UDim2.new(0.05, 0, 0, 152)
    AutoSaveBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
    AutoSaveBtn.Text = "🔄 Auto Save: OFF"
    AutoSaveBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    AutoSaveBtn.TextSize, AutoSaveBtn.Font = 11, Enum.Font.SourceSansBold
    AutoSaveBtn.Parent = MainFrame
    Instance.new("UICorner", AutoSaveBtn).CornerRadius = UDim.new(0, 5)

    AutoSaveBtn.MouseButton1Click:Connect(function()
        autoSaveActive = not autoSaveActive
        if autoSaveActive then
            AutoSaveBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
            AutoSaveBtn.Text = "🔄 Auto Save: ON (Every 10s)"
        else
            AutoSaveBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
            AutoSaveBtn.Text = "🔄 Auto Save: OFF"
        end
    end)

    task.spawn(function()
        while true do
            task.wait(10)
            if autoSaveActive then
                local root = getRootPart()
                if root then
                    saveLocationToFile(root.CFrame)
                end
            end
        end
    end)

    local TpBtn = Instance.new("TextButton")
    TpBtn.Size = UDim2.new(0.9, 0, 0, 35)
    TpBtn.Position = UDim2.new(0.05, 0, 0, 192)
    TpBtn.BackgroundColor3 = Color3.fromRGB(50, 100, 200)
    TpBtn.Text = "🚀 Teleport to Saved"
    TpBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    TpBtn.TextSize, TpBtn.Font = 11, Enum.Font.SourceSansBold
    TpBtn.Parent = MainFrame
    Instance.new("UICorner", TpBtn).CornerRadius = UDim.new(0, 5)

    local AntiKickStatus = Instance.new("TextLabel")
    AntiKickStatus.Size = UDim2.new(0.9, 0, 0, 30)
    AntiKickStatus.Position = UDim2.new(0.05, 0, 0, 235)
    AntiKickStatus.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    AntiKickStatus.TextColor3 = Color3.fromRGB(0, 255, 128)
    AntiKickStatus.Text = "🛡️ Anti-Kick: Protected & Active"
    AntiKickStatus.TextSize, AntiKickStatus.Font = 10, Enum.Font.SourceSansBold
    AntiKickStatus.Parent = MainFrame
    Instance.new("UICorner", AntiKickStatus).CornerRadius = UDim.new(0, 5)

    local savedCF = nil
    SaveBtn.MouseButton1Click:Connect(function()
        local root = getRootPart()
        if root then
            savedCF = root.CFrame
            saveLocationToFile(savedCF)
            StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 128)
            StatusLabel.Text = "Status: Saved Manually! ✅"
        end
    end)

    TpBtn.MouseButton1Click:Connect(function()
        local root = getRootPart()
        if root and savedCF then
            root.CFrame = savedCF
        else
            StatusLabel.Text = "Error: No saved location! ❌"
        end
    end)

    ReportBtn.MouseButton1Click:Connect(function()
        ReportBtn.Text = "✅ تم إرسال البلاغ بنجاح!"
        task.wait(2)
        ReportBtn.Text = "📩 إرسال شكوى / بلاغ"
    end)
end

local vipUsedFile = "Abdelrahman_VIP_Used.json"
local function checkAndLockVIP()
    local success, result = pcall(function()
        if isfile and isfile(vipUsedFile) then
            return true
        end
        if writefile then
            writefile(vipUsedFile, "USED_VIP_DEVICE")
        end
        return false
    end)
    return success and result
end

-- زر التحقق الوحيد
SubmitBtn.MouseButton1Click:Connect(function()
    local ok, msg = checkMaintenanceTime()
    if not ok then
        KeyTitle.TextColor3 = Color3.fromRGB(255, 50, 50)
        KeyTitle.Text = msg
        pcall(function()
            LocalPlayer:Kick(msg)
        end)
        return
    end

    local txt = InputBox.Text
    if txt == "VIP" then
        if checkAndLockVIP() then
            InputBox.Text = ""
            InputBox.PlaceholderText = "❌ كود VIP مستخدم مسبقاً على هذا الجهاز!"
        else
            BootHub(true)
        end
    elseif txt == "FREE_6272727" then
        BootHub(false)
    else
        InputBox.Text = ""
        InputBox.PlaceholderText = "❌ الكود خطأ، حاول مجدداً!"
    end
end)
